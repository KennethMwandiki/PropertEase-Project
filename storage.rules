rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read for listings (images)
    // Write requires authentication
    match /listings/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow public read for 3D tours
    // Write requires authentication
    match /tours/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
